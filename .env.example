# ──────────────────────────────────────────────
# LLOA REFORESTATION — Environment Variables
# ──────────────────────────────────────────────

## Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

## Database
DATABASE_URL=postgresql://user:password@host:5432/lloa_reforestation
DB_SSL_REJECT_UNAUTHORIZED=true

## Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

## CORS
CORS_ORIGIN=http://localhost:4200

## Error Monitoring (optional — set only in production)
SENTRY_DSN=https://your-dsn@sentry.io/your-project

## Clustering (optional — enabled only when CLUSTER_ENABLED=true)
CLUSTER_ENABLED=false
WORKERS=2
