# ──────────────────────────────────────────────
# LLOA REFORESTATION — Environment Variables
# ──────────────────────────────────────────────

## Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

## Database (Supabase PostgreSQL)
# Obtener desde: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL_REJECT_UNAUTHORIZED=true

## Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

## CORS
CORS_ORIGIN=http://localhost:4200

## Error Monitoring (optional — set only in production)
SENTRY_DSN=https://your-dsn@sentry.io/your-project

## Clustering (optional — enabled only when CLUSTER_ENABLED=true)
CLUSTER_ENABLED=false
WORKERS=2
