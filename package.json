{
  "name": "app-reforestation-project",
  "version": "1.0.0",
  "private": true,
  "description": "Lloa Reforestation - Plataforma para trazabilidad ambiental de reforestación",
  "scripts": {
    "dev:server": "pnpm --dir server start",
    "dev:client": "npm --prefix client start",
    "lint:server": "pnpm --dir server lint",
    "install:all": "pnpm --dir server install && npm --prefix client install",
    "prepare": "husky",
    "build": "node scripts/build-client.js",
    "build:prod": "node scripts/build.js",
    "start": "node server/src/index.js",
    "migrate": "node server/src/db/migrate.js"
  },
  "lint-staged": {
    "server/src/**/*.js": [
      "pnpm --dir server lint"
    ],
    "client/src/**/*.ts": [
      "bash -c 'client/node_modules/.bin/tsc --noEmit --project client/tsconfig.app.json'"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
