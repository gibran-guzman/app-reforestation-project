# ──────────────────────────────────────────────────────────────
# LLOA REFORESTATION — PRODUCCIÓN (Supabase)
# Copia este archivo a server/.env y completa los valores.
# NO subas este archivo a git (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────

## Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

## Dominio real del frontend (solo este podrá consumir la API)
CORS_ORIGIN=https://tu-dominio

## Database — Supabase (Project Settings → Database → Connection string → URI)
## Usa la conexión del pooler (port 6543) o la directa, siempre con sslmode=require
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

## Supabase — Project Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
SUPABASE_ANON_KEY=<ANON_KEY>

## Login encryption — clave privada RSA persistente (base64 PKCS#8 PEM)
## Generar: openssl genrsa -out login.key 2048 && base64 -w0 login.key
## Si se omite, se genera una clave efímera en memoria (pierde logins en curso en cada restart)
LOGIN_ENCRYPTION_PRIVATE_KEY=

## Database SSL
DB_SSL_REJECT_UNAUTHORIZED=true

## Error monitoring (opcional, solo producción)
SENTRY_DSN=

## Clustering (opcional)
CLUSTER_ENABLED=false
WORKERS=2
