# ──────────────────────────────────────────────────────────────
# LLOA REFORESTATION — VARIABLES DE PRODUCCIÓN (Supabase/Seenode)
# Única plantilla de entorno. Copia los valores al apartado
# "Variables de entorno" de Seenode (o a server/.env si corres local).
# ──────────────────────────────────────────────────────────────

## Servidor
NODE_ENV=production
LOG_LEVEL=info

## Dominio exacto del frontend. En Seenode es la URL pública que te asigne
## (ej: https://tu-app-xxxx.seenode.app), sin barra final.
CORS_ORIGIN=https://tu-url-de-seenode.seenode.app

## Database — PostgreSQL de Supabase
## Supabase → Project Settings → Database → Connection string → URI (pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL_REJECT_UNAUTHORIZED=true

## Supabase — Project Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
SUPABASE_ANON_KEY=<ANON_KEY>

## Cifrado del login — clave privada RSA persistente (base64 PKCS#8 PEM)
## Generar: openssl genrsa -out login.key 2048 && base64 -w0 login.key
## Sin esta clave el servidor genera una efímera que se pierde en cada reinicio
## e invalida los logins en curso. OBLIGATORIA en producción.
LOGIN_ENCRYPTION_PRIVATE_KEY=<clave-rsa-base64>

## Opcionales — deja vacío/falso si no los usas
SENTRY_DSN=
CLUSTER_ENABLED=false
WORKERS=2
