# ──────────────────────────
# Server Configuration
# ──────────────────────────
PORT=3000

# Cambiar a 'production' en despliegue real para activar CSP y restricciones de CORS
NODE_ENV=development
LOG_LEVEL=info

# En producción, debe ser el dominio exacto del frontend (ej: https://lloareforestacion.app)
# Para desarrollo local dejar como está
CORS_ORIGIN=http://localhost:4200

# ──────────────────────────
# Database (Supabase PostgreSQL)
# ──────────────────────────
# Obtener desde: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Usar la conexión directa (port 54326) o pooler (port 6543), siempre con sslmode=require
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# ──────────────────────────
# Supabase (Authentication)
# ──────────────────────────
# Obtener desde: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (pública) — necesaria para login y refresh token.
# SIN ESTA VARIABLE, el servidor no arranca (evita usar la service role key
# para login, lo que BYPASSEA RLS y rompe el aislamiento de permisos).
SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────
# Login encryption (RSA)
# ──────────────────────────
# Clave privada RSA (base64 del PEM PKCS#8) usada para descifrar la contraseña
# que el cliente cifra en el login. Si no se define, el servidor genera una clave
# efímera en memoria que se pierde en cada reinicio (invalidando logins en curso).
# Generar con: openssl genrsa -out login.key 2048 && base64 -w0 login.key
LOGIN_ENCRYPTION_PRIVATE_KEY=

# ──────────────────────────
# Database SSL (producción)
# ──────────────────────────
# En producción con SSL (ej: Supabase), la conexión requiere SSL.
# Si el certificado no es verificado, usar:
# DB_SSL_REJECT_UNAUTHORIZED=false
